    "verify:phase-c": "node scripts/verify-phase-c.mjs",
    "verify:stage-e": "node scripts/verify-stage-e.cjs && node scripts/verify-release-consistency.mjs",
    "verify:stage-f": "node scripts/verify-project-delivery.mjs",
    "verify:phase-c-persona": "node scripts/verify-phase-c-persona.mjs",
