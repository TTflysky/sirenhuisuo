    "verify:user-memory-quality": "node scripts/verify-user-memory-quality.mjs",
    "verify:native-execution-policy": "node scripts/verify-native-execution-policy.cjs",
    "verify:module-boundaries": "node scripts/verify-module-boundaries.cjs",
