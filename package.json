    "verify:v050-team-hall": "node scripts/verify-v050-team-hall.mjs",
    "verify:skill-evidence-ui": "node scripts/verify-skill-evidence-ui.mjs",
    "verify:foundation-ui": "node scripts/verify-foundation-e2e.mjs",
    "dist:win": "powershell -ExecutionPolicy Bypass -File scripts/build-windows.ps1",
    "publish:release": "powershell -ExecutionPolicy Bypass -File scripts/publish-github-release.ps1",
    "release:win": "npm.cmd run publish:release",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.2",
    "@ant-design/v5-patch-for-react-19": "^1.0.3",
    "antd": "^6.5.1",
    "docx": "9.5.1",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.5.0",
    "extract-zip": "2.0.1",
    "officeparser": "^7.4.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "yauzl": "2.10.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  },
  "build": {
    "appId": "com.hermes.office",
    "productName": "太极 AI 办公会所",
    "electronDist": "node_modules/electron/dist",
    "artifactName": "taiji-office-setup-${version}.${ext}",
    "files": [
      "dist/**",
      "electron/**",
      "src/engine/*.mjs",
      "public/tray-icon.png",
      "skills/**"
    ],
    "directories": {
      "output": "release"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "太极 AI 办公会所"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "TTflysky",
        "repo": "sirenhuisuo",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    }
  }
}
