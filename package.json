{
  "name": "hermes-office-pro",
  "private": true,
  "version": "1.0.2",
  "description": "太极 AI 办公会所 - 面向 Windows 的多模型协作与可恢复任务执行平台",
  "author": "TTflysky",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "start": "electron .",
    "status:project": "powershell -ExecutionPolicy Bypass -File scripts/project-status.ps1",
    "sync:project": "powershell -ExecutionPolicy Bypass -File scripts/sync-project.ps1 -Mode All",
    "diagnose:web-search": "electron scripts/diagnose-web-search-live.cjs",
    "verify:docx": "node scripts/verify-docx-output.cjs",
    "verify:assistant-background": "node scripts/verify-assistant-background.mjs",
    "verify:agent-kernel": "node scripts/verify-agent-kernel.mjs",
    "verify:connector-adapters": "node scripts/verify-connector-adapters.cjs",
    "verify:connector-protocol": "node scripts/verify-connector-protocol.mjs",
    "verify:execution-controller": "node scripts/verify-execution-controller.mjs",
    "verify:execution-evidence": "node scripts/verify-execution-evidence.mjs",
    "verify:package": "node scripts/verify-packaged-app.cjs",
    "verify:skill-atomic": "node scripts/verify-skill-atomic.cjs",
    "verify:update-download": "node scripts/verify-update-download.cjs",
