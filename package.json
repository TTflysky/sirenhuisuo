    "verify:task-recovery-gate": "node scripts/verify-task-recovery-gate.mjs",
    "verify:v1-core-gate": "node scripts/verify-v1-core-gate.mjs",
    "verify:v1-fault-injection": "node scripts/verify-v1-fault-injection.mjs",
    "verify:skill-activation-evidence": "node scripts/verify-skill-activation-evidence.cjs",
    "verify:task-approval-metrics": "node scripts/verify-task-approval-metrics.mjs",
    "verify:coding-task-contract": "node scripts/verify-coding-task-contract.mjs",
    "verify:completion-gate": "node scripts/verify-completion-gate.mjs",
    "verify:chat-task-service": "node scripts/verify-chat-task-service.mjs",
    "verify:child-task-dispatch": "node scripts/verify-child-task-dispatch.mjs",
    "verify:unified-tool-evidence": "node scripts/verify-unified-tool-evidence.mjs",
    "verify:task-plan-service": "node scripts/verify-task-plan-service.mjs",
    "verify:task-retry-policy": "node scripts/verify-task-retry-policy.mjs",
    "verify:task-plan": "node scripts/verify-task-plan.mjs",
    "verify:task-runner": "node scripts/verify-task-runner.mjs",
    "verify:task-context": "node scripts/verify-task-context.mjs",
    "verify:context-router": "node scripts/verify-task-context-router.mjs",
    "verify:context-tool-pairs": "node scripts/verify-context-tool-pairs.mjs",
    "verify:layered-memory": "node scripts/verify-layered-memory.cjs",
    "verify:learning-review": "node scripts/verify-learning-review.cjs",
    "verify:memory-ui": "node scripts/verify-memory-ui.mjs",
    "verify:skill-drafts": "node scripts/verify-skill-drafts.cjs",
    "verify:task-delegation": "node scripts/verify-task-delegation.mjs",
    "verify:worktree": "node scripts/verify-worktree-manager.cjs",
    "verify:ecosystem-health": "node scripts/verify-ecosystem-health.cjs",
    "verify:task-history": "node scripts/verify-task-history.mjs",
    "verify:task-runtime-store": "node scripts/verify-task-runtime-store.cjs",
