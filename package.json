    "verify:task-semantics-benchmark": "node scripts/verify-task-semantics-benchmark.mjs",
    "verify:task-decision-pipeline": "node scripts/verify-task-decision-pipeline.mjs",
    "verify:model-reliability": "node scripts/verify-model-reliability.mjs",
    "verify:phase-a": "npm.cmd run test:run -- --reporter=dot && npm.cmd run verify:task-semantics-benchmark && npm.cmd run verify:task-decision-pipeline && npm.cmd run verify:model-reliability",
    "verify:external-capability-matrix": "node scripts/verify-external-capability-matrix.mjs",
    "verify:phase-b": "npm.cmd run test:run -- --reporter=dot && npm.cmd run verify:external-capability-matrix && npm.cmd run verify:skill-evidence && npm.cmd run verify:skill-evidence-ui && npm.cmd run verify:explicit-resource-contract && npm.cmd run build",
