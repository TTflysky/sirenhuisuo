    "verify:dispatch-intelligence": "node scripts/verify-dispatch-intelligence.mjs",
    "verify:team-mentions": "node scripts/verify-team-mentions.mjs",
    "verify:task-handoff": "node scripts/verify-task-handoff.mjs",
    "verify:task-state-machine": "node scripts/verify-task-state-machine.mjs",
    "verify:execution-protocol": "node scripts/verify-execution-protocol.mjs",
    "verify:skill-evidence": "node scripts/verify-skill-evidence.mjs",
    "verify:dynamic-delegation-v2": "node scripts/verify-dynamic-delegation-v2.mjs",
    "verify:recovery-capsule-v2": "node scripts/verify-recovery-capsule-v2.mjs",
