    "verify:update-control": "node scripts/verify-update-control.mjs",
    "verify:phase1": "npm.cmd run test:run && node scripts/verify-phase1-architecture.mjs && node scripts/verify-task-semantics-benchmark.mjs",
    "verify:phase2": "node scripts/verify-phase2.mjs",
    "verify:model-compatibility": "vitest run test/unit/modelCompatibility.test.mjs",
    "verify:skill-runtime": "node scripts/verify-skill-runtime.cjs",
    "verify:credential-vault": "node scripts/verify-credential-vault.cjs",
    "verify:update-transaction": "node scripts/verify-update-transaction.cjs",
