{
  "name": "hermes-office-pro",
  "private": true,
  "version": "0.24.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "start": "electron .",
    "status:project": "powershell -ExecutionPolicy Bypass -File scripts/project-status.ps1",
    "sync:project": "powershell -ExecutionPolicy Bypass -File scripts/sync-project.ps1 -Mode All",
    "diagnose:web-search": "electron scripts/diagnose-web-search-live.cjs",
    "verify:docx": "node scripts/verify-docx-output.cjs",
    "verify:assistant-background": "node scripts/verify-assistant-background.mjs",
    "verify:agent-kernel": "node scripts/verify-agent-kernel.mjs",
    "verify:connector-adapters": "node scripts/verify-connector-adapters.cjs",
    "verify:connector-protocol": "node scripts/verify-connector-protocol.mjs",
    "verify:execution-controller": "node scripts/verify-execution-controller.mjs",
    "verify:execution-evidence": "node scripts/verify-execution-evidence.mjs",
    "verify:package": "node scripts/verify-packaged-app.cjs",
    "verify:skill-atomic": "node scripts/verify-skill-atomic.cjs",
    "verify:update-download": "node scripts/verify-update-download.cjs",
    "verify:web-search": "node scripts/verify-web-search.cjs",
    "verify:steering-e2e": "node scripts/verify-steering-e2e.mjs",
    "verify:tool-window": "node scripts/verify-tool-window.mjs",
    "verify:foundation": "node scripts/verify-foundation.mjs",
    "verify:task-plan": "node scripts/verify-task-plan.mjs",
    "verify:task-runner": "node scripts/verify-task-runner.mjs",
    "verify:task-context": "node scripts/verify-task-context.mjs",
    "verify:task-history": "node scripts/verify-task-history.mjs",
    "verify:task-runtime-store": "node scripts/verify-task-runtime-store.cjs",
    "verify:task-worker": "node scripts/verify-task-worker.cjs",
    "verify:native-execution": "node scripts/verify-native-execution-adapter.cjs",
    "verify:tool-registry": "node scripts/verify-tool-registry.mjs",
    "verify:office-layout": "node scripts/verify-office-layout.mjs",
    "verify:office-scroll": "node scripts/verify-office-scroll.mjs",
    "verify:team-membership": "node scripts/verify-team-membership.mjs",
    "verify:team-window-layout": "node scripts/verify-team-window-layout.mjs",
    "verify:foundation-ui": "node scripts/verify-foundation-e2e.mjs",
    "dist:win": "powershell -ExecutionPolicy Bypass -File scripts/build-windows.ps1",
    "publish:release": "powershell -ExecutionPolicy Bypass -File scripts/publish-github-release.ps1",
    "release:win": "npm.cmd run publish:release",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.2",
    "@ant-design/v5-patch-for-react-19": "^1.0.3",
    "antd": "^6.5.1",
    "docx": "9.5.1",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.5.0",
    "extract-zip": "2.0.1",
    "officeparser": "^7.4.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "yauzl": "2.10.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  },
  "build": {
    "appId": "com.hermes.office",
    "productName": "太极 AI 办公会所",
    "electronDist": "node_modules/electron/dist",
    "artifactName": "taiji-office-setup-${version}.${ext}",
    "files": [
      "dist/**",
      "electron/**",
      "src/engine/*.mjs",
      "public/tray-icon.png",
      "skills/**"
    ],
    "directories": {
      "output": "release"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "太极 AI 办公会所"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "TTflysky",
        "repo": "sirenhuisuo",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": null
    }
  }
}
